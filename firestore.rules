rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User workspaces - users can only read/write their own workspace
    match /workspaces/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User settings - users can only read/write their own settings
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Learning progress - users can only read/write their own progress
    match /learningProgress/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User files - users can only access their own files
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Subcollection for user files
      match /files/{fileId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Temporary files - allow authenticated users to read/write their own temp files
    match /tempFiles/{docId} {
      allow read, write: if isAuthenticated() && 
                           resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }
    
    // Public shared content (read-only for all authenticated users)
    match /sharedContent/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins can write (set via Admin SDK)
    }
  }
}
